        "properties": {
          "provider": {
            "minLength": 1,
            "pattern": "^(openai|gemini|claude|groq)$",
            "type": "string"
          },
          "apiKey": {
            "minLength": 1,
            "type": "string"
          },
          "displayName": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "defaultModel": {
